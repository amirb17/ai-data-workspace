# Copy privately to .env; never commit real credentials.
APP_ENV=development
AUTH_MODE=session
# Generate a private random value of at least 32 bytes; do not use a phrase.
AUTH_SECRET=
AUTH_FRONTEND_URL=http://localhost:5173
AUTH_BACKEND_URL=http://localhost:8000
AUTH_COOKIE_SECURE=false

# Configure the existing PostgreSQL / private data-plane variables separately.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ai_data_workspace

# SMTP always requires TLS (STARTTLS, or implicit TLS when SMTP_SSL=true).
AUTH_EMAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SSL=false

# Optional local-only mailbox; explicitly choose a private absolute directory
# outside frontend/ and any web-served folder. Do not enable in production.
# AUTH_EMAIL_BACKEND=development
# AUTH_DEV_MAILBOX_DIR=C:\Users\YOUR_USER\AppData\Local\DataRise\mailbox

# Google Sign-In is separate from the existing Gemini planner integration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register AUTH_BACKEND_URL/auth/google/callback in Google Cloud.

# Production: APP_ENV=production, AUTH_MODE=session, AUTH_COOKIE_SECURE=true,
# strong AUTH_SECRET, and same-site HTTPS frontend/backend origins.
# Legacy local identity remains opt-in and is forbidden outside development.
ENABLE_DEV_IDENTITY=false

# Metric BigQuery consumer rollout.
# Both controls default OFF. Primary promotion requires shadow execution too.
# BigQuery provider/project/location configuration remains separately controlled.
METRIC_BIGQUERY_SHADOW_ENABLED=false
METRIC_BIGQUERY_PRIMARY_ENABLED=false