#!/bin/bash
set -euo pipefail

# Dedicated IAM instance profile; never reuse the processing worker host.
dnf install -y docker
systemctl enable --now docker
mkdir -p /etc/ai-workspace
chmod 700 /etc/ai-workspace

cat > /etc/ai-workspace/dispatcher.env <<'ENVFILE'
AWS_DEFAULT_REGION=${region}
DATARISE_PROCESSING_DEPLOYMENT_APPROVED=false
DATARISE_PROCESSING_READERS=false
DATARISE_DISPATCH_APPROVED=false
DATARISE_DISPATCH_IAM_ROLE_ARN=${role_arn}
DATARISE_DISPATCH_DB_SECRET_ARN=${secret}
DATARISE_PROCESSING_QUEUE_URL=${queue}
ENVFILE
chmod 600 /etc/ai-workspace/dispatcher.env

cat > /usr/local/bin/ai-workspace-dispatcher-start <<'SCRIPT'
#!/bin/bash
set -euo pipefail
IMAGE_URI="${image_uri}"
REGISTRY="${registry_host}"
REGION="${region}"
for flag in DATARISE_PROCESSING_DEPLOYMENT_APPROVED DATARISE_PROCESSING_READERS DATARISE_DISPATCH_APPROVED; do
  if ! grep -Fxq "$flag=true" /etc/ai-workspace/dispatcher.env; then
    echo "Dispatcher release disabled" >&2
    exit 78
  fi
done
aws ecr get-login-password --region "$REGION" | docker login --username AWS --password-stdin "$REGISTRY"
docker pull "$IMAGE_URI"
exec docker run --rm \
  --name ai-workspace-dispatcher \
  --init --read-only \
  --tmpfs /tmp:rw,noexec,nosuid,size=128m \
  --cap-drop=ALL \
  --security-opt=no-new-privileges \
  --pids-limit=128 --memory=512m --cpus=1 \
  --log-driver=json-file --log-opt=max-size=10m --log-opt=max-file=3 \
  --env-file /etc/ai-workspace/dispatcher.env \
  --entrypoint python "$IMAGE_URI" -m app.processing_worker.dispatcher_container_entrypoint
SCRIPT
chmod 700 /usr/local/bin/ai-workspace-dispatcher-start

cat > /etc/systemd/system/ai-workspace-dispatcher.service <<'UNIT'
[Unit]
Description=AI Workspace Dedicated Outbox Dispatcher
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/local/bin/ai-workspace-dispatcher-start
ExecStop=-/usr/bin/docker stop -t 90 ai-workspace-dispatcher
RuntimeDirectory=ai-workspace-dispatcher-login
RuntimeDirectoryMode=0700
Environment=DOCKER_CONFIG=/run/ai-workspace-dispatcher-login
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=15
TimeoutStartSec=300
TimeoutStopSec=105

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
# Intentionally not enabled or started until runtime authorization is proved.
