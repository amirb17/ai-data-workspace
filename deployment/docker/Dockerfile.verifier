
# AWS Lambda Python 3.13 runtime.
ARG VERIFIER_BASE_IMAGE
FROM ${VERIFIER_BASE_IMAGE}
ARG VERIFIER_BASE_IMAGE
ARG SOURCE_REVISION
ARG RUNTIME_LOCK_SHA
LABEL org.opencontainers.image.revision=${SOURCE_REVISION} \
      io.datarise.base-image=${VERIFIER_BASE_IMAGE} \
      io.datarise.requirements-sha256=${RUNTIME_LOCK_SHA}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHON_DOTENV_DISABLED=1 \
    DATARISE_PROCESSING_DEPLOYMENT_APPROVED=false \
    DATARISE_PROCESSING_READERS=false \
    DATARISE_DISPATCH_APPROVED=false \
    OPENBLAS_NUM_THREADS=1 \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1

WORKDIR ${LAMBDA_TASK_ROOT}
# Public Amazon RDS CA bundle for PostgreSQL TLS verification.
COPY deployment/docker/certs/global-bundle.pem /opt/certs/global-bundle.pem

ENV PGSSLMODE=verify-full \
    PGSSLROOTCERT=/opt/certs/global-bundle.pem
# Use the application's declared dependencies rather than
# maintaining another potentially incomplete package list.
COPY pyproject.toml uv.lock ./
COPY deployment/docker/requirements.lock deployment/docker/verify_lock.py ./deployment/docker/

RUN python -c "import sys,tomllib; assert sys.version_info[:2] == (3,13); p=tomllib.load(open('pyproject.toml','rb')); assert p['project']['dependencies']" \
    && python deployment/docker/verify_lock.py --base "$VERIFIER_BASE_IMAGE" --revision "$SOURCE_REVISION" --requirements-hash "$RUNTIME_LOCK_SHA" \
    && python -m pip install --no-cache-dir --no-deps --only-binary=:all: --require-hashes -r deployment/docker/requirements.lock

# Copy the application source, including existing verifier,
# database repository, and processing algorithms.
COPY app ./app

# Lambda must invoke the trusted verifier, not the SQS job worker.
CMD ["app.lambda_worker.verifier_handler.lambda_handler"]
