# Refresh the public API application over the verified ECS runtime without
# rebuilding dependencies or changing its fixed uvicorn entrypoint.
ARG API_RUNTIME_IMAGE
FROM ${API_RUNTIME_IMAGE}
ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=${SOURCE_REVISION} \
      io.datarise.api-runtime-overlay="true"

WORKDIR /app
COPY --chown=10002:10002 app/ ./app/
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PYTHON_DOTENV_DISABLED=1

USER 10002
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-proxy-headers"]
