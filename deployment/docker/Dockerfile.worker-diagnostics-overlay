# Refresh the complete application package over the verified worker runtime.
# Partial overlays can leave incompatible old modules behind.
ARG WORKER_RUNTIME_IMAGE
FROM ${WORKER_RUNTIME_IMAGE}
ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=${SOURCE_REVISION} \
      io.datarise.worker-diagnostics-overlay="true"
WORKDIR /app
COPY --chown=10001:10001 app/ /app/app/
# Fail the build if the Bronze processing import graph is incomplete.
RUN python -c "from app.processing.exact_decimal import ExactDecimalSpec; from app.services.processing_service import start_processing; from app.processing_worker.integrated_executor import IntegratedExecutor; print('BRONZE_IMPORT_GRAPH_OK')"
USER 10001
CMD ["python", "-m", "app.processing_worker.container_entrypoint"]
