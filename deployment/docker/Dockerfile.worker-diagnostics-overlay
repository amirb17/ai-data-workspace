# Minimal, reversible diagnostics overlay on the already verified worker runtime.
# Does not rebuild dependencies, change database privileges, or expose raw exceptions.
ARG WORKER_RUNTIME_IMAGE
FROM ${WORKER_RUNTIME_IMAGE}
ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=${SOURCE_REVISION} \
      io.datarise.worker-diagnostics-overlay="true"
WORKDIR /app
COPY --chown=10001:10001 app/processing_worker/execution.py /app/app/processing_worker/execution.py
USER 10001
CMD ["python", "-m", "app.processing_worker.container_entrypoint"]
