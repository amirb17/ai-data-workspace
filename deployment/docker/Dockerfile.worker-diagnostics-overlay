# Rebuild the worker's complete locked Python runtime over its reviewed base image.
# The former application-only overlay could not run Bronze: pydantic was absent.
ARG WORKER_RUNTIME_IMAGE
FROM ${WORKER_RUNTIME_IMAGE}
ARG WORKER_RUNTIME_IMAGE
ARG SOURCE_REVISION
ARG RUNTIME_LOCK_SHA
LABEL org.opencontainers.image.revision=${SOURCE_REVISION} \
      io.datarise.worker-runtime-repair="locked-dependencies-and-complete-app"
USER root
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app PYTHON_DOTENV_DISABLED=1
COPY pyproject.toml uv.lock README.md ./
COPY deployment/docker/requirements.lock deployment/docker/verify_lock.py ./deployment/docker/
COPY --chown=10001:10001 app/ ./app/
RUN python deployment/docker/verify_lock.py --base "$WORKER_RUNTIME_IMAGE" --revision "$SOURCE_REVISION" --requirements-hash "$RUNTIME_LOCK_SHA" \
    && python -m pip install --no-cache-dir --no-deps --only-binary=:all: --require-hashes -r deployment/docker/requirements.lock \
    && python -c "import pydantic,pandas,pyarrow,psycopg,boto3; from app.processing.exact_decimal import ExactDecimalSpec; from app.services.processing_service import start_processing; from app.processing_worker.integrated_executor import IntegratedExecutor; print('BRONZE_IMPORT_GRAPH_OK')"
USER 10001
CMD ["python", "-m", "app.processing_worker.container_entrypoint"]
