# Surgical source refresh over the already verified, dependency-complete worker runtime.
# Never rebuild/pull unpinned dependencies for a one-line Gold execution fix.
ARG WORKER_RUNTIME_IMAGE
FROM ${WORKER_RUNTIME_IMAGE}
ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=${SOURCE_REVISION} \\
      io.datarise.worker-source-overlay="gold-dependency-epoch-unprivileged-read"
WORKDIR /app
COPY --chown=10001:10001 app/ ./app/
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app PYTHON_DOTENV_DISABLED=1
USER 10001
CMD ["python", "-m", "app.processing_worker.container_entrypoint"]
